<?xml version="1.0"?>
<package format="3">
  <name>ros2_epos_cmd</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge between Slicer needle commands and Maxon EPOS4 motors.</description>
  <maintainer email="pjs2207@pusan.ac.kr">Pusan National University, Advanced Robotics Lab</maintainer>
  <license>LicenseRef-PNU-ARL-Academic-Research-Only-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
